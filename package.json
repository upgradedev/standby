{
  "name": "standby",
  "private": true,
  "type": "module",
  "workspaces": ["apps/console"],
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "build": "npm run build --workspace @standby/console && node scripts/build-api.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspace @standby/console",
    "test": "tsx --test packages/domain/test/*.test.ts services/api/test/*.test.ts apps/console/src/lib/capacityReplay.test.ts apps/console/src/lib/capacity.test.ts",
    "check:secrets": "python scripts/check-secrets.py"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1160.0",
    "@aws-sdk/client-dynamodb": "3.1160.0",
    "@aws-sdk/lib-dynamodb": "3.1160.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
